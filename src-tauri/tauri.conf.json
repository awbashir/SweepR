{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SweepR",
  "version": "0.1.0",
  "identifier": "com.sweepr.networkscanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SweepR",
        "width": 1360,
        "height": 820,
        "minWidth": 980,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "category": "DeveloperTool",
    "shortDescription": "Enterprise IPv4/IPv6 network scanner",
    "longDescription": "SweepR scans IPv4 and IPv6 networks, 802.1Q VLANs and discovers switches, firewalls and access points via CDP, LLDP and SNMP.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
