{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the SweepR main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "ssh://*" },
        { "url": "telnet://*" }
      ]
    },
    "allow-list-interfaces",
    "allow-start-scan",
    "allow-stop-scan",
    "allow-start-vlan-discovery",
    "allow-export-devices",
    "allow-load-overrides",
    "allow-save-override",
    "allow-scan-ports",
    "allow-query-snmp",
    "allow-wake-device",
    "allow-start-latency-monitor",
    "allow-stop-latency-monitor",
    "allow-start-trace",
    "allow-stop-trace",
    "allow-grab-web-identity",
    "allow-iperf-available",
    "allow-start-iperf",
    "allow-stop-iperf"
  ]
}
